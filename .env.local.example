NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key Supabase — HANYA dipakai di server (webhook Midtrans),
# JANGAN pernah pakai prefix NEXT_PUBLIC_ dan jangan expose ke client.
# Ambil dari Supabase Dashboard -> Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Midtrans — ambil dari Midtrans Dashboard -> Settings -> Access Keys
# Gunakan key SB- (Sandbox) dulu untuk testing, ganti ke key produksi saat go-live.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# URL publik situs, dipakai untuk redirect setelah pembayaran Midtrans selesai.
# Saat development bisa dibiarkan localhost, saat produksi ganti ke domain asli.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notifikasi email status pesanan (Resend — https://resend.com, gratis untuk uji coba).
# Tanpa RESEND_API_KEY email dilewati. EMAIL_FROM harus domain terverifikasi di Resend;
# untuk uji coba pakai onboarding@resend.dev (hanya bisa kirim ke email pemilik akun Resend).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Explore Malang <onboarding@resend.dev>

# Tampilkan tombol "Masuk/Daftar dengan Google" (set true SETELAH provider Google aktif di Supabase)
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# Asisten AI di halaman Hubungi Kami (opsional). Ambil key di https://console.anthropic.com
# Tanpa key ini chatbot tetap jalan memakai jawaban berbasis kata kunci.
# JANGAN pakai prefix NEXT_PUBLIC_ — key hanya boleh ada di server.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model (opsional, bawaan claude-haiku-5-5 yang cepat & murah)
ANTHROPIC_MODEL=claude-haiku-5-5
